# Production environment template — copy into host secrets / secret manager, never commit real values

NODE_ENV=production
PORT=5000
TRUST_PROXY_HOPS=1
# Must be set in the process environment BEFORE Node starts (Docker ENV / systemd / PM2):
UV_THREADPOOL_SIZE=8
SHUTDOWN_TIMEOUT_MS=15000

# Fail boot on production checklist warnings (recommended)
STRICT_PRODUCTION=true
# Swagger off in production (set true only behind VPN + nginx allowlist)
ENABLE_SWAGGER=false

DB_HOST=your-managed-postgres-host
DB_PORT=5432
DB_NAME=app
DB_USER=
DB_PASSWORD=
# Managed Postgres: require TLS
DB_SSL=require
# Set false only if provider uses a private CA you have not mounted
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

BCRYPT_COST=12

CLIENT_URL=https://shop.yourdomain.com
CORS_ORIGINS=https://shop.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=https://shop.yourdomain.com
API_PUBLIC_ORIGIN=https://api.yourdomain.com

ALLOW_MOCK_PAYMENT=false
EMAIL_USE_QUEUE=true

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production (fail-fast unless METRICS_ALLOW_INSECURE=true on a private mesh)
METRICS_BEARER_TOKEN=

# Cluster-wide rate limits when running multiple API replicas
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_REQUIRE_REDIS=true

# Optional offsite backups (AWS CLI on host)
# BACKUP_S3_URI=s3://your-bucket/db-backups
# BACKUP_KEEP_LOCAL=true
# AWS_REGION=us-east-1
