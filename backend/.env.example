NODE_ENV=development
PORT=5000

# API docs (after npm run dev): http://localhost:5000/api/docs
# Production: leave unset/false (docs disabled). Set true only for private debug.
# ENABLE_SWAGGER=true
# STRICT_PRODUCTION=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=e-commerce
DB_USER=postgres
DB_PASSWORD=your_db_password

# Pool / TLS (production managed DB: DB_SSL=require)
# DB_POOL_MAX=20
# DB_SSL=require

# Use long random strings (32+ chars). Access and refresh MUST differ in production.
JWT_SECRET=
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

# bcrypt work factor (integer 10–15). Default 10. Production often uses 12.
# Successful logins rehash when stored cost is lower than this value.
BCRYPT_COST=10
# Set in process manager / Docker ENV *before* Node starts (not changeable at runtime):
# libuv threadpool — set before Node starts (bcrypt). Suggested 8–16 on multi-core hosts.
UV_THREADPOOL_SIZE=8

# JWT + cookie TTL share one source of truth (EXPIRES). MAX_AGE_MS is optional legacy;
# if both are set and differ, EXPIRES wins and a startup error is logged.
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
ACCESS_TOKEN_MAX_AGE_MS=900000
REFRESH_TOKEN_MAX_AGE_MS=604800000

# Public origin of this API (used for SameSite auto-detect vs CORS frontends)
API_PUBLIC_ORIGIN=http://localhost:5000
# Optional override: lax | none | strict
# COOKIE_SAMESITE=lax
# Optional host-only by default; set only if you must share cookies across API host aliases
# COOKIE_DOMAIN=
# Multi-tab refresh race grace (ms). Previous refresh token accepted until this elapses.
REFRESH_ROTATION_GRACE_MS=30000
# CHIPS Partitioned: auto (prod + SameSite=None only) | true | false — see docs/COOKIES.md
# COOKIE_PARTITIONED=auto
# Playwright cookie E2E (never set in production) — skips rate limits when NODE_ENV !== production
# E2E_RELAX_RATE_LIMIT=true
# Local load audits only (never production):
# LOAD_TEST_BYPASS=1

# Comma-separated allowed frontend origins
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

PASSWORD_MIN_LENGTH=8

# Mobile app PIN length (digits only), both default 4–6
MOBILE_PIN_MIN=4
MOBILE_PIN_MAX=6

RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=60
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_ADMIN_READ=300
RATE_LIMIT_ADMIN_WRITE=80
RATE_LIMIT_ADMIN_SENSITIVE=15
# Legacy — used as fallback for RATE_LIMIT_ADMIN_READ if unset
# RATE_LIMIT_ADMIN=300
RATE_LIMIT_UPLOAD=40
RATE_LIMIT_CONTACT=5
RATE_LIMIT_SEARCH=60
# Legacy alias — loginLimiter falls back to this if RATE_LIMIT_LOGIN is unset
# RATE_LIMIT_AUTH=10

GOOGLE_CLIENT_ID=
CLIENT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio SMS (optional — until set, SMS prefs save but sends are skipped/logged)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Or use a Messaging Service instead of FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@matinacrafts.com

# Queue outbound mail (run npm run email:worker in another process)
EMAIL_USE_QUEUE=true
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=20

STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) — optional in local; required in production
STRIPE_WEBHOOK_SECRET=
# Checkout currency (USA store default)
STRIPE_CURRENCY=usd
# Instant “paid” without Stripe — OFF unless you explicitly set true (local testing only)
ALLOW_MOCK_PAYMENT=false

RATE_LIMIT_VERIFY_EMAIL=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: sync homepage reviews from Google Places
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# # Optional: Google reCAPTCHA (enforced on register/login when set)
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# Optional: Sentry error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus /metrics (required in production — fail-fast without token). Prefix defaults to app_
METRICS_BEARER_TOKEN=
METRICS_PREFIX=app_
# Comma-separated IPs or CIDRs (optional): 10.0.0.0/8,192.168.1.10
METRICS_ALLOWLIST_IPS=
# METRICS_REQUIRE_PRIVATE_IP=true
# METRICS_ALLOW_INSECURE=true   # escape hatch only — never in real prod
SERVICE_NAME=ecommerce-api

# Cluster-wide rate limits (required when running multiple API replicas)
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_REQUIRE_REDIS=true
# RATE_LIMIT_REDIS_PREFIX=rl:

# Slow request logging threshold (ms)
SLOW_REQUEST_MS=1000
SHUTDOWN_TIMEOUT_MS=15000

# OpenTelemetry (optional OTLP/HTTP)
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ecommerce-api

# Abuse / lockout
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15
SLOW_DOWN_AFTER=80

LOG_FORMAT=json
LOG_LEVEL=info
